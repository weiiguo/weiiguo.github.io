#!/usr/bin/env bash
# Sourced by the project scripts; does not change the user's shell configuration.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
if command -v rbenv >/dev/null 2>&1; then
  export PATH="$(rbenv root)/shims:$PATH"
fi
expected_ruby=$(cat .ruby-version)
if [[ "$(ruby -e 'print RUBY_VERSION')" != "$expected_ruby" ]]; then
  echo "This project needs Ruby $expected_ruby. Run: rbenv install -s $expected_ruby" >&2
  exit 1
fi
export JEKYLL_ENV=production
